# Frontend Environment Variables Template
# Cấu hình URL cơ sở của API cho frontend
# Khi đặt là /api, Vite dev server sẽ proxy các request /api sang backend (http://localhost:3000)
# Production trên Vercel: VITE_API_BASE_URL=https://nosqlproject-hfc6.onrender.com/api
# Đổi biến trên Vercel xong cần redeploy vì Vite nhúng URL khi build.
# Domain backend không có đường dẫn sẽ tự được thêm /api.
# Nếu bỏ trống: dev dùng /api, production dùng https://nosqlproject-hfc6.onrender.com/api.
VITE_API_BASE_URL=/api

# Optional: origin/base path serving relative question images (defaults to API host root).
# VITE_ASSET_BASE_URL=https://assets.example.com/
