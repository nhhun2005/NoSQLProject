# =================================================================
# Backend Environment Variables Template
# =================================================================

# Cổng lắng nghe của backend Express server (Tùy chọn, mặc định: 3000)
PORT=3000

# Chuỗi kết nối MongoDB (BẮT BUỘC - server không có giá trị mặc định fallback)
# Ví dụ chạy MongoDB cục bộ (Lưu ý: tên database QuizApp chỉ là ví dụ mẫu, tên DB thực tế chưa rõ):
MONGO_URI=mongodb://127.0.0.1:27017/QuizApp
# Nếu sử dụng MongoDB Atlas (cần thay username, password, cluster và database thực tế):
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-address>/<database_name>?retryWrites=true&w=majority
# Lưu ý: Cần URL-encode các ký tự đặc biệt trong username hoặc password.

# Khóa bí mật ký JWT (BẮT BUỘC cho tính năng xác thực và phân quyền)
# Tạo giá trị an toàn ngẫu nhiên bằng lệnh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Việc đổi secret sẽ làm vô hiệu hóa token đăng nhập cũ của người dùng, nhưng không làm mất tài khoản/mật khẩu trong DB.
JWT_SECRET=CHANGE_ME_JWT_SECRET_GENERATE_WITH_NODE_CRYPTO
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET_GENERATE_WITH_NODE_CRYPTO

# API key của dịch vụ Resend dùng cho tính năng gửi OTP qua backend/api/sendEmail.js
# BẮT BUỘC KHI KHỞI ĐỘNG: Trong backend/api/sendEmail.js, lệnh `new Resend(process.env.RESEND_API_KEY)` nằm ở module scope
# nên thiếu key này sẽ khiến thư viện ném lỗi ngoại lệ (throw) làm sập server ngay lúc nạp route xác thực.
# Lưu ý: Địa chỉ người gửi trong code được gán cứng là 'Quiz Company <noreply@nhhun2005.id.vn>',
# do đó để gửi mail thực tế đến hòm thư người nhận, domain nhhun2005.id.vn phải được xác minh (verify) trên Resend.
RESEND_API_KEY=re_REPLACE_WITH_REAL_KEY
